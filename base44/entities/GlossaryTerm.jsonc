{
  "name": "GlossaryTerm",
  "type": "object",
  "description": "Definitions shown on the public X1 glossary page.",
  "properties": {
    "term": {
      "type": "string",
      "description": "The word or phrase being defined."
    },
    "description": {
      "type": "string",
      "description": "One or two sentences defining the term the way X1 Space uses it."
    },
    "category": {
      "type": "string",
      "enum": [
        "network",
        "validators",
        "tokens",
        "markets"
      ],
      "enumColors": [
        "blue",
        "purple",
        "green",
        "yellow"
      ],
      "default": "network",
      "description": "Group the term is listed under."
    },
    "aliases": {
      "type": "string",
      "description": "Other names for the same thing, comma separated."
    },
    "related_url": {
      "type": "string",
      "description": "App path that shows the term in context, for example /Validators."
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Order within its category."
    }
  },
  "required": [
    "term",
    "description"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}